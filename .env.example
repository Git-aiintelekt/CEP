# Copy to .env (never commit .env)
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.cep.localhost
# Label in the back-office header so nobody mistakes production for a test system: Production | Staging | anything. Empty = Local (DEBUG) or Production.
CEP_ENVIRONMENT=
DATABASE_URL=postgres://cep:cep@127.0.0.1:5432/cep_pool
# Django Admin / management commands: a BYPASSRLS login that is a member of cep_admin (never the app role)
PLATFORM_DATABASE_URL=postgres://cep:cep@127.0.0.1:5432/cep_pool
# ---- Email sent by the platform (password links, alerts, support-access notices). Usually entered in the product instead:
# back-office -> Configuration -> Mail server (platform), Settings -> Email server (tenant). These are the fallback. Leave EMAIL_HOST empty in development:
# messages are then printed to the server log. Port 587 + EMAIL_USE_TLS, or port 465 + EMAIL_USE_SSL (never both).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CEP <no-reply@example.com>
EMAIL_REPLY_TO=
EMAIL_PRODUCT_NAME=Customer Engagement Platform

# Public address of this API (identity providers redirect back to it) and of the back-office (alert emails link to it)
API_PUBLIC_URL=http://localhost:8000
PLATFORM_ADMIN_URL=http://localhost:8000

# Fernet key for secrets stored in the database (MFA secrets, SSO client secrets). Generate one per environment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# DDL-owner login, used ONLY by tenant export / move / offboarding (they copy and erase with triggers off)
OWNER_DATABASE_URL=
TENANT_EXPORT_DIR=

# Public URL of the React app (one-time password links point here)
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Media / CDN (leave MEDIA_BUCKET empty for local filesystem storage)
MEDIA_BUCKET=
MEDIA_REGION=us-east-1
CDN_BASE_URL=
S3_ENDPOINT_URL=
