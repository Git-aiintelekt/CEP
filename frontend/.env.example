# Copy to .env.local to override. Only VITE_* variables reach the browser: never put secrets here.

# Base path of the CEP API. In development Vite proxies /api to the Django server (see vite.config.ts).
VITE_API_BASE_URL=/api/v1

# Where the Vite dev proxy forwards /api, /admin, /healthz, /static and /media
VITE_DEV_BACKEND=http://localhost:8000

# Hostnames the dev server answers to besides localhost, comma-separated. Vite blocks any other Host header, so a
# server that runs `npm run dev` behind a proxy (e.g. cepdev.example.com) sets its public name here, in its .env.local.
VITE_DEV_ALLOWED_HOSTS=

# Tenant sent as the X-Tenant header when the hostname carries no tenant subdomain (local development).
# In production the tenant comes from <tenant>.cep.example.com and this is ignored.
VITE_DEFAULT_TENANT=NWA
# Subdomains of this installation that never name a workspace (the login page then asks for the workspace code); cepdev and ceptest are built in
VITE_RESERVED_SUBDOMAINS=
